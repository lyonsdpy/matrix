# 复制到 /etc/matrix/web.env，chmod 600，仅 matrix 用户可读。切勿入库。
# 取值须与 Go API 的 configs/config.yaml 对应字段保持一致。

# Go API 地址（Next.js 服务端内部调用，同机即用 localhost）
GO_API_URL=http://127.0.0.1:8080
# Next.js <-> Go API 共享密钥，须等于 config.yaml 的 lark.internal_secret 明文值
INTERNAL_SECRET=请填入与后端一致的密钥
# 飞书应用 App ID，与 config.yaml 的 lark.app_id 一致
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
# 飞书 OAuth 回调，须与飞书开放平台 + config.yaml 的 oauth_redirect_uri 完全一致（线上域名）
LARK_REDIRECT_URI=https://你的域名/api/auth/callback
# JWT 有效期，与 config.yaml 的 jwt.expiry_hours 一致
JWT_EXPIRY_HOURS=24
# 生产走 HTTPS 时设 true，强制 session cookie 仅 HTTPS
HTTPS_ONLY=true
