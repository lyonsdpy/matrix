# 复制为 .env.local 后填值。.env.local 在 .gitignore 里，不会入库。
# 这些变量仅在 dev 模式下生效，生产构建不读取。

# ===== EDR 检测 mock =====
# pass / fail / 留空（走真实后端 /api/v1/acg/edr-check）
# VITE_EDR_MOCK=pass

# ===== 后端 API 基址 =====
# 浏览器调后端 EDR 检查接口的基址，例如 http://api.xlbsoft.com 或 http://localhost:8080
# 留空时按相对路径请求（要求 acg-checker 与后端同源部署）
VITE_API_BASE_URL=

# ===== 飞书认证 =====
# 注意：APP SECRET 绝不能放进任何 VITE_ 变量，那是服务端 (B 系统) 才有的东西
# 飞书应用 ID（与 ACG 后台 oauth_auth_config 配置的 app_id 一致）
VITE_FEISHU_APP_ID=
# 飞书后台白名单中已注册的 OAuth 回调端点，即 ACG 的 oauth_auth_submit.php。
# 不要带 query：D 会在跳飞书前把 action + ACG 业务参数（weburl/uplcyid）拼上去。
VITE_FEISHU_REDIRECT_URI=
# 飞书回调时 redirect_uri 上附加的 action 参数。ACG 默认期望 oauth_login_code。
# VITE_FEISHU_CALLBACK_ACTION=oauth_login_code
# 可选：state 参数，用来防 CSRF
# VITE_FEISHU_STATE=test
